<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Avaliação de Estágio — IESC III | Afya Contagem</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    /* Identidade aproximada a partir do cabeçalho da Afya (gradiente magenta -> roxo).
       Se você tiver o manual de marca com os hex oficiais, é só trocar aqui. */
    --afya-magenta:#E5007D;
    --afya-purple:#5B2C86;
    --afya-purple-dark:#3D1E5C;
    --afya-bg:#F7F5FA;
    --afya-card:#FFFFFF;
    --afya-text:#2B2038;
    --afya-muted:#7A7188;
    --afya-border:#E7E1EE;
    --afya-success:#1F9D55;
    --afya-warn:#C9862B;
    --afya-danger:#D33A5A;
    --radius:14px;
    --shadow:0 4px 18px rgba(59,20,90,0.08);
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:'Poppins',sans-serif; background:var(--afya-bg); color:var(--afya-text);
    -webkit-font-smoothing:antialiased;
  }
  .topbar{
    background:linear-gradient(115deg, var(--afya-magenta) 0%, var(--afya-purple) 65%, var(--afya-purple-dark) 100%);
    color:#fff; padding:18px 28px; display:flex; align-items:center; justify-content:space-between;
    box-shadow:var(--shadow);
  }
  .topbar .brand{display:flex; flex-direction:column; line-height:1.15;}
  .topbar .brand b{font-size:18px; font-weight:800; letter-spacing:.3px;}
  .topbar .brand span{font-size:12.5px; opacity:.9;}
  .topbar .who{display:flex; align-items:center; gap:14px; font-size:13.5px;}
  .topbar button.logout{
    background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.35); color:#fff;
    padding:7px 14px; border-radius:20px; cursor:pointer; font-family:inherit; font-size:13px;
  }
  .topbar button.logout:hover{background:rgba(255,255,255,.28);}
  .wrap{max-width:980px; margin:0 auto; padding:28px 20px 60px;}

  /* ---------- Login ---------- */
  .login-shell{
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, var(--afya-magenta) 0%, var(--afya-purple) 55%, var(--afya-purple-dark) 100%);
    padding:20px;
  }
  .login-card{
    background:var(--afya-card); border-radius:20px; padding:40px 36px; width:100%; max-width:400px;
    box-shadow:0 20px 50px rgba(0,0,0,.25); text-align:center;
  }
  .login-card h1{font-size:20px; margin:6px 0 4px; font-weight:800;}
  .login-card p{color:var(--afya-muted); font-size:13.5px; margin:0 0 26px;}
  .login-card input{
    width:100%; padding:13px 14px; border-radius:10px; border:1.5px solid var(--afya-border);
    font-family:inherit; font-size:14px; margin-bottom:14px;
  }
  .login-card input:focus{outline:none; border-color:var(--afya-magenta);}
  .btn-primary{
    width:100%; padding:13px 14px; border:none; border-radius:10px; cursor:pointer;
    background:linear-gradient(115deg, var(--afya-magenta), var(--afya-purple));
    color:#fff; font-family:inherit; font-size:14.5px; font-weight:600;
  }
  .btn-primary:hover{filter:brightness(1.06);}
  .btn-primary:disabled{opacity:.55; cursor:not-allowed;}
  .login-msg{margin-top:16px; font-size:13px;}
  .login-msg.ok{color:var(--afya-success);}
  .login-msg.err{color:var(--afya-danger);}
  .logo-mark{
    width:52px; height:52px; margin:0 auto 14px; border-radius:14px;
    background:linear-gradient(135deg, var(--afya-magenta), var(--afya-purple));
    display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:22px;
  }

  /* ---------- Cards / geral ---------- */
  .card{background:var(--afya-card); border-radius:var(--radius); padding:22px 24px; box-shadow:var(--shadow); margin-bottom:20px;}
  .card h2{font-size:16px; margin:0 0 16px; font-weight:700;}
  .card h3{font-size:14px; margin:18px 0 10px; font-weight:600; color:var(--afya-purple);}
  label{display:block; font-size:12.5px; font-weight:600; color:var(--afya-muted); margin-bottom:5px; text-transform:uppercase; letter-spacing:.3px;}
  select, input[type=date], input[type=text], input[type=number], input[type=email], textarea{
    width:100%; padding:10px 12px; border-radius:9px; border:1.5px solid var(--afya-border);
    font-family:inherit; font-size:13.5px; margin-bottom:14px; background:#fff; color:var(--afya-text);
  }
  select:focus, input:focus, textarea:focus{outline:none; border-color:var(--afya-magenta);}
  textarea{resize:vertical; min-height:60px;}
  .row2{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  .criterio-opts{display:flex; flex-direction:column; gap:8px; margin-bottom:10px;}
  .opt{
    display:flex; align-items:flex-start; gap:10px; padding:10px 12px; border-radius:10px;
    border:1.5px solid var(--afya-border); cursor:pointer; font-size:13px;
  }
  .opt:hover{border-color:var(--afya-magenta);}
  .opt.selected{border-color:var(--afya-magenta); background:rgba(229,0,125,0.06);}
  .opt input{margin:2px 0 0; width:auto;}
  .opt .pts{font-weight:700; color:var(--afya-purple); min-width:42px;}
  .total-box{
    display:flex; align-items:center; justify-content:space-between; padding:14px 18px;
    background:var(--afya-bg); border-radius:10px; margin:18px 0; font-weight:700; font-size:15px;
  }
  .total-box b{color:var(--afya-magenta); font-size:20px;}
  table{width:100%; border-collapse:collapse; font-size:13px;}
  th, td{text-align:left; padding:9px 10px; border-bottom:1px solid var(--afya-border);}
  th{font-size:11.5px; text-transform:uppercase; letter-spacing:.3px; color:var(--afya-muted);}
  tr:hover td{background:rgba(91,44,134,0.03);}
  .badge{display:inline-block; padding:2px 9px; border-radius:20px; font-size:11.5px; font-weight:600;}
  .badge.ok{background:rgba(31,157,85,.12); color:var(--afya-success);}
  .tabs{display:flex; gap:6px; margin-bottom:18px; flex-wrap:wrap;}
  .tab-btn{
    padding:9px 16px; border-radius:20px; border:1.5px solid var(--afya-border); background:#fff;
    cursor:pointer; font-family:inherit; font-size:13px; font-weight:600; color:var(--afya-muted);
  }
  .tab-btn.active{background:linear-gradient(115deg, var(--afya-magenta), var(--afya-purple)); color:#fff; border-color:transparent;}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}
  .btn-sm{
    padding:6px 12px; border-radius:8px; border:1.5px solid var(--afya-border); background:#fff;
    cursor:pointer; font-family:inherit; font-size:12px; font-weight:600; color:var(--afya-purple);
  }
  .btn-sm:hover{border-color:var(--afya-magenta);}
  .btn-sm.danger{color:var(--afya-danger);}
  .filters{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;}
  .filters select{width:auto; min-width:160px; margin-bottom:0;}
  .toolbar{display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;}
  .muted{color:var(--afya-muted); font-size:12.5px;}
  .hidden{display:none !important;}
  .rubrica-row td input[type=text]{margin:0;}
  .rubrica-row td input[type=number]{margin:0; width:90px;}
  .toast{
    position:fixed; bottom:24px; right:24px; background:var(--afya-purple-dark); color:#fff; padding:12px 18px;
    border-radius:10px; font-size:13px; box-shadow:var(--shadow); opacity:0; transform:translateY(10px);
    transition:.25s; pointer-events:none; z-index:50;
  }
  .toast.show{opacity:1; transform:translateY(0);}
  .toast.err{background:var(--afya-danger);}
  @media (max-width:600px){ .row2{grid-template-columns:1fr;} }
</style>
</head>
<body>

<!-- ============================ LOGIN ============================ -->
<div id="login-screen" class="login-shell">
  <div class="login-card">
    <div class="logo-mark">A</div>
    <h1>Avaliação de Estágio</h1>
    <p>IESC III — Afya Contagem<br>Entre com seu e-mail cadastrado</p>
    <input type="email" id="login-email" placeholder="seu.email@exemplo.com" autocomplete="email">
    <button class="btn-primary" id="btn-login">Enviar link de acesso</button>
    <div id="login-msg" class="login-msg"></div>
  </div>
</div>

<!-- ============================ APP ============================ -->
<div id="app" class="hidden">
  <div class="topbar">
    <div class="brand">
      <b>Avaliação de Estágio · IESC III</b>
      <span id="topbar-sub">Afya Faculdade de Ciências Médicas de Contagem</span>
    </div>
    <div class="who">
      <span id="who-label"></span>
      <button class="logout" id="btn-logout">Sair</button>
    </div>
  </div>

  <div class="wrap">

    <!-- ---------- VISÃO PRECEPTORA ---------- -->
    <div id="preceptora-view" class="hidden">

      <div class="card">
        <h2>Lançar avaliação semanal</h2>
        <div class="row2">
          <div>
            <label>Aluno(a)</label>
            <select id="sel-aluno"></select>
          </div>
          <div>
            <label>Data da visita</label>
            <input type="date" id="inp-data-visita">
          </div>
        </div>
        <label>Nº da visita (opcional)</label>
        <input type="number" id="inp-visita-numero" min="1" style="max-width:140px;">

        <div id="form-criterios"></div>

        <div class="total-box">
          <span>Nota total da semana</span>
          <span><b id="total-display">0,0</b> / 15,0</span>
        </div>
        <button class="btn-primary" id="btn-salvar-avaliacao">Salvar avaliação</button>
      </div>

      <div class="card">
        <div class="toolbar">
          <h2 style="margin:0;">Minhas avaliações lançadas</h2>
        </div>
        <table id="tbl-minhas-avaliacoes">
          <thead><tr><th>Aluno</th><th>Data</th><th>Nota</th><th></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <!-- ---------- VISÃO ADMIN ---------- -->
    <div id="admin-view" class="hidden">
      <div class="tabs">
        <button class="tab-btn active" data-tab="tab-avaliacoes">Avaliações</button>
        <button class="tab-btn" data-tab="tab-rubricas">Rubricas</button>
        <button class="tab-btn" data-tab="tab-preceptoras">Preceptoras</button>
      </div>

      <!-- Avaliações consolidadas -->
      <div id="tab-avaliacoes" class="tab-panel active">
        <div class="card">
          <div class="toolbar">
            <h2 style="margin:0;">Avaliações consolidadas</h2>
            <button class="btn-sm" id="btn-export-csv">Exportar CSV</button>
          </div>
          <div class="filters">
            <select id="filtro-ubs"><option value="">Todas as UBS</option></select>
            <select id="filtro-preceptora"><option value="">Todas as preceptoras</option></select>
          </div>
          <table id="tbl-admin-avaliacoes">
            <thead><tr>
              <th>UBS</th><th>Preceptora</th><th>Aluno</th><th>Data</th>
              <th>Assid.</th><th>Conh.</th><th>Postura</th><th>Total</th><th></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>

      <!-- Rubricas editáveis -->
      <div id="tab-rubricas" class="tab-panel">
        <div class="card">
          <h2>Configurar pontuação das rubricas</h2>
          <p class="muted">Altere a descrição e/ou a pontuação de qualquer nível. Avaliações já lançadas mantêm a nota registrada no momento do envio — a mudança vale para os próximos lançamentos.</p>

          <h3>1. Assiduidade</h3>
          <table><tbody id="rub-assiduidade"></tbody></table>
          <h3>2. Conhecimentos e Habilidades</h3>
          <table><tbody id="rub-conhecimentos"></tbody></table>
          <h3>3. Postura e Colaboração</h3>
          <table><tbody id="rub-postura"></tbody></table>

          <button class="btn-primary" style="max-width:220px; margin-top:16px;" id="btn-salvar-rubricas">Salvar rubricas</button>
        </div>
      </div>

      <!-- Preceptoras -->
      <div id="tab-preceptoras" class="tab-panel">
        <div class="card">
          <h2>Preceptoras cadastradas</h2>
          <p class="muted">Cadastre o e-mail institucional de cada preceptora — é com ele que ela recebe o link de acesso.</p>
          <table>
            <thead><tr><th>Nome</th><th>UBS</th><th>E-mail</th><th></th></tr></thead>
            <tbody id="tbl-preceptoras"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<div id="toast" class="toast"></div>

<script>
/* =======================================================================
   CONFIGURAÇÃO — troque pelos dados do seu projeto Supabase
   ======================================================================= */
const SUPABASE_URL = "https://SEU-PROJETO.supabase.co";
const SUPABASE_ANON_KEY = "SUA_ANON_KEY_AQUI";

const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let CURRENT_USER = null;
let IS_ADMIN = false;
let MY_PRECEPTORA = null;
let RUBRICAS = [];           // todas as linhas da tabela rubricas
let MEUS_ALUNOS = [];
let SELECIONADOS = {assiduidade:null, conhecimentos:null, postura:null};
let EDITANDO_ID = null;      // id da avaliação em edição (preceptora)

const CRITERIO_LABEL = {assiduidade:"Assiduidade", conhecimentos:"Conhecimentos e Habilidades", postura:"Postura e Colaboração"};

/* ---------------------------- util ---------------------------- */
function toast(msg, isErr){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (isErr ? ' err' : '');
  setTimeout(()=> t.classList.remove('show'), 3200);
}
function fmt(n){ return Number(n).toFixed(1).replace('.', ','); }

/* ---------------------------- auth ---------------------------- */
document.getElementById('btn-login').addEventListener('click', async ()=>{
  const email = document.getElementById('login-email').value.trim();
  const msg = document.getElementById('login-msg');
  if(!email){ msg.textContent = "Digite seu e-mail."; msg.className="login-msg err"; return; }
  document.getElementById('btn-login').disabled = true;
  const { error } = await sb.auth.signInWithOtp({ email, options:{ emailRedirectTo: window.location.href } });
  document.getElementById('btn-login').disabled = false;
  if(error){ msg.textContent = "Erro ao enviar link: " + error.message; msg.className="login-msg err"; return; }
  msg.textContent = "Link enviado! Confira sua caixa de entrada (e o spam).";
  msg.className = "login-msg ok";
});

document.getElementById('btn-logout').addEventListener('click', async ()=>{
  await sb.auth.signOut();
  window.location.reload();
});

sb.auth.onAuthStateChange((event, session)=>{
  if(session && session.user){ CURRENT_USER = session.user; boot(); }
});

async function boot(){
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  document.getElementById('who-label').textContent = CURRENT_USER.email;

  const { data: adminCheck } = await sb.rpc('is_admin');
  IS_ADMIN = !!adminCheck;

  await loadRubricas();

  if(IS_ADMIN){
    document.getElementById('admin-view').classList.remove('hidden');
    initAdmin();
  } else {
    const { data: prec, error } = await sb.from('preceptoras').select('*').eq('email', CURRENT_USER.email).maybeSingle();
    if(error || !prec){
      toast("Seu e-mail ainda não está vinculado a nenhuma preceptora. Fale com o administrador.", true);
      return;
    }
    MY_PRECEPTORA = prec;
    document.getElementById('preceptora-view').classList.remove('hidden');
    document.getElementById('topbar-sub').textContent = prec.ubs;
    initPreceptora();
  }
}

/* ============================================================
   VISÃO PRECEPTORA
   ============================================================ */
async function initPreceptora(){
  const { data: alunos } = await sb.from('alunos').select('*').eq('preceptora_id', MY_PRECEPTORA.id).eq('ativo', true).order('nome');
  MEUS_ALUNOS = alunos || [];
  const sel = document.getElementById('sel-aluno');
  sel.innerHTML = MEUS_ALUNOS.map(a => `<option value="${a.id}">${a.nome}</option>`).join('');

  document.getElementById('inp-data-visita').valueAsDate = new Date();

  renderCriterioForm();
  await loadMinhasAvaliacoes();

  document.getElementById('btn-salvar-avaliacao').addEventListener('click', salvarAvaliacao);
}

function renderCriterioForm(){
  const container = document.getElementById('form-criterios');
  container.innerHTML = '';
  ['assiduidade','conhecimentos','postura'].forEach(crit=>{
    const opts = RUBRICAS.filter(r=>r.criterio===crit).sort((a,b)=>a.ordem-b.ordem);
    const block = document.createElement('div');
    block.innerHTML = `<h3>${CRITERIO_LABEL[crit]} (máx ${fmt(Math.max(...opts.map(o=>o.pontos)))} pts)</h3>
      <div class="criterio-opts" id="opts-${crit}">
        ${opts.map(o=>`
          <label class="opt" data-crit="${crit}" data-id="${o.id}">
            <input type="radio" name="${crit}" value="${o.id}">
            <span class="pts">${fmt(o.pontos)}</span>
            <span>${o.descricao}</span>
          </label>`).join('')}
      </div>
      <textarea placeholder="Comentário / justificativa (opcional)" id="coment-${crit}"></textarea>`;
    container.appendChild(block);
  });

  container.querySelectorAll('.opt').forEach(el=>{
    el.addEventListener('click', ()=>{
      const crit = el.dataset.crit;
      document.querySelectorAll(`#opts-${crit} .opt`).forEach(o=>o.classList.remove('selected'));
      el.classList.add('selected');
      el.querySelector('input').checked = true;
      SELECIONADOS[crit] = el.dataset.id;
      atualizarTotal();
    });
  });
}

function atualizarTotal(){
  let total = 0;
  ['assiduidade','conhecimentos','postura'].forEach(crit=>{
    const r = RUBRICAS.find(x=>x.id===SELECIONADOS[crit]);
    if(r) total += Number(r.pontos);
  });
  document.getElementById('total-display').textContent = fmt(total);
}

async function salvarAvaliacao(){
  const aluno_id = document.getElementById('sel-aluno').value;
  const data_visita = document.getElementById('inp-data-visita').value;
  const visita_numero = document.getElementById('inp-visita-numero').value || null;

  if(!aluno_id || !data_visita){ toast("Selecione o aluno e a data.", true); return; }
  if(!SELECIONADOS.assiduidade || !SELECIONADOS.conhecimentos || !SELECIONADOS.postura){
    toast("Preencha os três critérios antes de salvar.", true); return;
  }

  const rAssid = RUBRICAS.find(r=>r.id===SELECIONADOS.assiduidade);
  const rConh  = RUBRICAS.find(r=>r.id===SELECIONADOS.conhecimentos);
  const rPost  = RUBRICAS.find(r=>r.id===SELECIONADOS.postura);

  const payload = {
    aluno_id, preceptora_id: MY_PRECEPTORA.id, data_visita, visita_numero,
    assiduidade_pontos: rAssid.pontos, assiduidade_comentario: document.getElementById('coment-assiduidade').value || null,
    conhecimentos_pontos: rConh.pontos, conhecimentos_comentario: document.getElementById('coment-conhecimentos').value || null,
    postura_pontos: rPost.pontos, postura_comentario: document.getElementById('coment-postura').value || null,
  };
  if(EDITANDO_ID) payload.id = EDITANDO_ID;

  const { error } = await sb.from('avaliacoes').upsert(payload, { onConflict: EDITANDO_ID ? 'id' : 'aluno_id,data_visita' });
  if(error){ toast("Erro ao salvar: " + error.message, true); return; }

  toast("Avaliação salva com sucesso.");
  EDITANDO_ID = null;
  await loadMinhasAvaliacoes();
}

async function loadMinhasAvaliacoes(){
  const { data } = await sb.from('avaliacoes')
    .select('*, alunos(nome)')
    .eq('preceptora_id', MY_PRECEPTORA.id)
    .order('data_visita', {ascending:false});

  const tbody = document.querySelector('#tbl-minhas-avaliacoes tbody');
  tbody.innerHTML = (data||[]).map(a=>`
    <tr>
      <td>${a.alunos?.nome ?? ''}</td>
      <td>${new Date(a.data_visita+'T00:00:00').toLocaleDateString('pt-BR')}</td>
      <td><span class="badge ok">${fmt(a.nota_total)}</span></td>
      <td><button class="btn-sm" onclick="editarAvaliacao('${a.id}')">Editar</button></td>
    </tr>`).join('') || '<tr><td colspan="4" class="muted">Nenhuma avaliação lançada ainda.</td></tr>';
}

window.editarAvaliacao = async function(id){
  const { data } = await sb.from('avaliacoes').select('*').eq('id', id).single();
  if(!data) return;
  EDITANDO_ID = id;
  document.getElementById('sel-aluno').value = data.aluno_id;
  document.getElementById('inp-data-visita').value = data.data_visita;
  document.getElementById('inp-visita-numero').value = data.visita_numero || '';

  const map = {assiduidade:data.assiduidade_pontos, conhecimentos:data.conhecimentos_pontos, postura:data.postura_pontos};
  ['assiduidade','conhecimentos','postura'].forEach(crit=>{
    const r = RUBRICAS.filter(x=>x.criterio===crit).find(x=>Number(x.pontos)===Number(map[crit]));
    if(r){
      SELECIONADOS[crit] = r.id;
      document.querySelectorAll(`#opts-${crit} .opt`).forEach(o=>o.classList.toggle('selected', o.dataset.id===r.id));
      document.querySelector(`#opts-${crit} .opt[data-id="${r.id}"] input`).checked = true;
    }
  });
  document.getElementById('coment-assiduidade').value = data.assiduidade_comentario || '';
  document.getElementById('coment-conhecimentos').value = data.conhecimentos_comentario || '';
  document.getElementById('coment-postura').value = data.postura_comentario || '';
  atualizarTotal();
  window.scrollTo({top:0, behavior:'smooth'});
  toast("Editando avaliação — altere e clique em Salvar.");
};

/* ============================================================
   VISÃO ADMIN
   ============================================================ */
function initAdmin(){
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.tab).classList.add('active');
    });
  });

  renderRubricasAdmin();
  document.getElementById('btn-salvar-rubricas').addEventListener('click', salvarRubricas);

  loadAdminAvaliacoes();
  loadPreceptorasAdmin();
  document.getElementById('btn-export-csv').addEventListener('click', exportarCSV);
  document.getElementById('filtro-ubs').addEventListener('change', loadAdminAvaliacoes);
  document.getElementById('filtro-preceptora').addEventListener('change', loadAdminAvaliacoes);
}

function renderRubricasAdmin(){
  ['assiduidade','conhecimentos','postura'].forEach(crit=>{
    const tbody = document.getElementById('rub-' + crit);
    const rows = RUBRICAS.filter(r=>r.criterio===crit).sort((a,b)=>a.ordem-b.ordem);
    tbody.innerHTML = rows.map(r=>`
      <tr class="rubrica-row" data-id="${r.id}">
        <td style="width:70%;"><input type="text" value="${r.descricao.replace(/"/g,'&quot;')}" class="rub-desc"></td>
        <td><input type="number" step="0.5" value="${r.pontos}" class="rub-pts"></td>
      </tr>`).join('');
  });
}

async function salvarRubricas(){
  const rows = document.querySelectorAll('.rubrica-row');
  const updates = [];
  rows.forEach(row=>{
    updates.push({
      id: row.dataset.id,
      descricao: row.querySelector('.rub-desc').value,
      pontos: parseFloat(row.querySelector('.rub-pts').value)
    });
  });
  for(const u of updates){
    const { error } = await sb.from('rubricas').update({descricao:u.descricao, pontos:u.pontos}).eq('id', u.id);
    if(error){ toast("Erro ao salvar rubrica: " + error.message, true); return; }
  }
  toast("Rubricas atualizadas.");
  await loadRubricas();
  renderRubricasAdmin();
}

async function loadAdminAvaliacoes(){
  let query = sb.from('avaliacoes')
    .select('*, alunos(nome, ubs), preceptoras(nome, ubs, email)')
    .order('data_visita', {ascending:false});

  const { data, error } = await query;
  if(error){ toast("Erro ao carregar avaliações: " + error.message, true); return; }

  const ubsSet = new Set((data||[]).map(a=>a.preceptoras?.ubs).filter(Boolean));
  const precSet = new Set((data||[]).map(a=>a.preceptoras?.nome).filter(Boolean));

  const selUbs = document.getElementById('filtro-ubs');
  const selPrec = document.getElementById('filtro-preceptora');
  if(selUbs.options.length <= 1){ ubsSet.forEach(u=> selUbs.innerHTML += `<option value="${u}">${u}</option>`); }
  if(selPrec.options.length <= 1){ precSet.forEach(p=> selPrec.innerHTML += `<option value="${p}">${p}</option>`); }

  const fUbs = selUbs.value, fPrec = selPrec.value;
  const filtered = (data||[]).filter(a =>
    (!fUbs || a.preceptoras?.ubs === fUbs) && (!fPrec || a.preceptoras?.nome === fPrec)
  );

  window.__ADMIN_AVALIACOES__ = filtered;

  const tbody = document.querySelector('#tbl-admin-avaliacoes tbody');
  tbody.innerHTML = filtered.map(a=>`
    <tr>
      <td>${a.preceptoras?.ubs ?? ''}</td>
      <td>${a.preceptoras?.nome ?? ''}</td>
      <td>${a.alunos?.nome ?? ''}</td>
      <td>${new Date(a.data_visita+'T00:00:00').toLocaleDateString('pt-BR')}</td>
      <td>${fmt(a.assiduidade_pontos)}</td>
      <td>${fmt(a.conhecimentos_pontos)}</td>
      <td>${fmt(a.postura_pontos)}</td>
      <td><span class="badge ok">${fmt(a.nota_total)}</span></td>
      <td><button class="btn-sm" onclick="adminEditarAvaliacao('${a.id}')">Ajustar</button></td>
    </tr>`).join('') || '<tr><td colspan="9" class="muted">Nenhuma avaliação lançada ainda.</td></tr>';
}

window.adminEditarAvaliacao = async function(id){
  const a = (window.__ADMIN_AVALIACOES__ || []).find(x=>x.id===id);
  if(!a) return;
  const novaA = prompt(`Assiduidade (${a.alunos?.nome}):`, a.assiduidade_pontos);
  if(novaA===null) return;
  const novaC = prompt("Conhecimentos e Habilidades:", a.conhecimentos_pontos);
  if(novaC===null) return;
  const novaP = prompt("Postura e Colaboração:", a.postura_pontos);
  if(novaP===null) return;

  const { error } = await sb.from('avaliacoes').update({
    assiduidade_pontos: parseFloat(novaA),
    conhecimentos_pontos: parseFloat(novaC),
    postura_pontos: parseFloat(novaP)
  }).eq('id', id);

  if(error){ toast("Erro ao ajustar: " + error.message, true); return; }
  toast("Avaliação ajustada pelo admin.");
  loadAdminAvaliacoes();
};

function exportarCSV(){
  const rows = window.__ADMIN_AVALIACOES__ || [];
  if(!rows.length){ toast("Nada para exportar.", true); return; }
  const header = ['UBS','Preceptora','Aluno','Data','Assiduidade','Conhecimentos','Postura','Nota Total','Visita Nº'];
  const lines = [header.join(';')];
  rows.forEach(a=>{
    lines.push([
      a.preceptoras?.ubs, a.preceptoras?.nome, a.alunos?.nome,
      new Date(a.data_visita+'T00:00:00').toLocaleDateString('pt-BR'),
      fmt(a.assiduidade_pontos), fmt(a.conhecimentos_pontos), fmt(a.postura_pontos),
      fmt(a.nota_total), a.visita_numero || ''
    ].join(';'));
  });
  const blob = new Blob(["\uFEFF" + lines.join('\n')], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url; link.download = `avaliacoes_iesc_${new Date().toISOString().slice(0,10)}.csv`;
  link.click();
}

async function loadPreceptorasAdmin(){
  const { data } = await sb.from('preceptoras').select('*').order('ubs');
  const tbody = document.getElementById('tbl-preceptoras');
  tbody.innerHTML = (data||[]).map(p=>`
    <tr data-id="${p.id}">
      <td>${p.nome}</td>
      <td>${p.ubs}</td>
      <td><input type="email" value="${p.email || ''}" class="prec-email" style="margin:0;"></td>
      <td><button class="btn-sm" onclick="salvarEmailPreceptora('${p.id}')">Salvar</button></td>
    </tr>`).join('');
}

window.salvarEmailPreceptora = async function(id){
  const row = document.querySelector(`#tbl-preceptoras tr[data-id="${id}"]`);
  const email = row.querySelector('.prec-email').value.trim();
  const { error } = await sb.from('preceptoras').update({email}).eq('id', id);
  if(error){ toast("Erro: " + error.message, true); return; }
  toast("E-mail atualizado.");
};

/* ---------------------------- rubricas (global) ---------------------------- */
async function loadRubricas(){
  const { data, error } = await sb.from('rubricas').select('*').order('criterio').order('ordem');
  if(error){ toast("Erro ao carregar rubricas: " + error.message, true); return; }
  RUBRICAS = data || [];
}
</script>
</body>
